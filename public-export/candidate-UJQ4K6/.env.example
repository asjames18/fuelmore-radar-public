# Backend only. Never prefix with VITE_ or commit a real provider URL/key.
RPC_URL=

# Maximum blocks per collector eth_getLogs request (Alchemy free: 10).
# Managed endpoints default to 10; legacy public endpoint defaults to 50000.
RPC_LOG_RANGE=10

# Scheduled publisher only; never expose these through VITE variables.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
