{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fuelmore-radar",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-09-15",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // The watchdog + market snapshot cron. Keep this in config: deploys sync
    // triggers from here, and an empty list silently deletes the trigger —
    // which caused the 2026-09-22 watchdog dispatch gap (trigger only
    // re-attached manually at 13:25 UTC, after the outage window).
    "crons": ["*/15 * * * *"]
  },
  "kv_namespaces": [
    {
      "binding": "ACTIVITY",
      "id": "4ee21ae0827e47a585602c260af73230"
    },
    {
      "binding": "COCKPIT_CACHE",
      "id": "efbf0ca8482f4ec487a23974a66c170a"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "e30ac5d4-9f16-4d29-82f0-c4bf48befeee"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/rpc*",
      "/api/*"
    ]
  },
  "vars": {
    "ANALYTICS_PRIVATE": "1"
  },
  "ratelimits": [
    {
      "name": "RPC_RATE_LIMITER",
      "namespace_id": "46631901",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ]
}
